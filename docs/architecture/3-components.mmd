---
config:
  flowchart:
    diagramPadding: 60
    nodeSpacing: 35
    rankSpacing: 90
    wrappingWidth: 400
---
flowchart LR
    Client(["Веб-приложение"])

    subgraph Pipeline["Middleware"]
        AuthN["Authentication<br/>нет JWT → 401"]
        AuthZ["Authorization<br/>чужая роль → 403"]
        Valid["Валидация модели<br/>→ 400"]
        AuthN --> AuthZ --> Valid
    end

    subgraph Controllers["Controllers"]
        AuthC["AuthController<br/>/api/auth"]
        CompaniesC["CompaniesController<br/>/api/companies/my"]
        UsersC["UsersController<br/>/api/users"]
        ToolsC["ToolsController<br/>/api/tools"]
        SyncC["SyncController<br/>/api/sync · /api/logs"]
        NotificationsC["NotificationsController<br/>/api/notifications"]
    end

    subgraph Services["Services"]
        AuthS["AuthService"]
        CompaniesS["CompaniesService"]
        UsersS["UsersService"]
        ToolsS["ToolsService"]
        SyncS["SyncService"]
        NotificationsS["NotificationsService"]
    end

    subgraph Events["Events"]
        Outbox["EventOutbox<br/>INSERT в транзакции сервиса"]
        Dispatcher["OutboxDispatcher<br/>фоновая отправка"]
    end

    Rabbit[("RabbitMQ<br/>→ AccountThis.Worker")]

    subgraph Security["Security"]
        Hasher["PasswordHasher"]
        Jwt["JwtTokenService"]
        Sig["SignatureService · Ed25519"]
        Qr["QrPayloadParser · AT1"]
    end

    subgraph DB["PostgreSQL · Npgsql"]
        companies[("companies")]
        users[("users")]
        rtokens[("refresh_tokens")]
        tools[("tools")]
        logs[("rental_logs")]
        holders[("tools_with_holders")]
        outbox[("outbox_events")]
        notifications[("notifications")]
    end

    Client --> AuthN
    Valid --> AuthC & CompaniesC & UsersC & ToolsC & SyncC & NotificationsC

    AuthC --> AuthS
    CompaniesC --> CompaniesS
    UsersC --> UsersS
    ToolsC --> ToolsS
    SyncC --> SyncS
    NotificationsC --> NotificationsS

    AuthS --> Hasher & Jwt & Sig
    SyncS --> Qr & Sig

    AuthS --> users & companies & rtokens
    CompaniesS --> companies
    UsersS --> users & rtokens
    ToolsS --> tools & holders
    SyncS --> logs & tools & users
    NotificationsS --> notifications & users

    AuthS & UsersS & ToolsS & SyncS --> Outbox
    Outbox --> outbox
    outbox --> Dispatcher --> Rabbit

    classDef actor fill:#1f4d3a,stroke:#3fb27f,color:#fff
    classDef mw fill:#1e3a5f,stroke:#4a8fd6,color:#fff
    classDef code fill:#23232f,stroke:#6b6b80,color:#fff
    classDef helper fill:#2a2f3a,stroke:#8a93a6,color:#fff
    classDef db fill:#3b2560,stroke:#8a63d2,color:#fff

    class Client actor
    class AuthN,AuthZ,Valid mw
    class AuthC,CompaniesC,UsersC,ToolsC,SyncC,NotificationsC,AuthS,CompaniesS,UsersS,ToolsS,SyncS,NotificationsS code
    class Hasher,Jwt,Sig,Qr,Outbox,Dispatcher helper
    class companies,users,rtokens,tools,logs,holders,outbox,notifications,Rabbit db
