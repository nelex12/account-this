---
config:
  flowchart:
    diagramPadding: 60
    nodeSpacing: 60
    rankSpacing: 80
    wrappingWidth: 400
---
flowchart LR
    subgraph Device["Браузер пользователя · HTTPS или localhost"]
        SPA["Веб-приложение<br/>Worker, Issuer, Owner<br/>React · Vite · TypeScript<br/>камера · WebCrypto"]
        Local[("Локальное хранилище<br/>ключ сервера, реестр,<br/>журнал, сертификат")]
    end

    subgraph Compose["Docker Compose"]
        Nginx["nginx · :80<br/>статика<br/>прокси /api/"]
        Backend["AccountThis.Api<br/>ASP.NET Core 8<br/>:8080, снаружи :5000<br/>OutboxDispatcher"]
        Worker["AccountThis.Worker<br/>.NET 8 Worker Service<br/>потребители audit, notifications"]
        Postgres[("PostgreSQL 16<br/>:5432<br/>volume postgres_data")]
        Rabbit[("RabbitMQ 4<br/>:5672 AMQP · :15672 UI<br/>exchange accountthis.events<br/>очереди audit, notifications,<br/>events.dead")]
    end

    Env[/".env<br/>POSTGRES_* · RABBITMQ_*<br/>ключи сервера и JWT"/]
    Init[/"Migrations/*.sql<br/>схема БД (применяет backend)"/]

    SPA -->|"HTTPS<br/>/api/* с JWT,<br/>/api/auth/* с cookie refresh_token"| Nginx
    Nginx -->|"proxy_pass"| Backend
    Backend -->|"Npgsql<br/>SQL, событие в outbox_events<br/>в той же транзакции"| Postgres
    Backend -->|"outbox → событие<br/>publisher confirms"| Rabbit
    Rabbit -->|"очереди audit,<br/>notifications"| Worker
    Worker -->|"audit_events,<br/>notifications"| Postgres

    Env -.-> Backend
    Env -.-> Worker
    Env -.-> Postgres
    Env -.-> Rabbit
    Init -.-> Backend

    classDef front fill:#1e3a5f,stroke:#4a8fd6,color:#fff
    classDef infra fill:#4a3520,stroke:#c08a4a,color:#fff
    classDef code fill:#23232f,stroke:#6b6b80,color:#fff
    classDef db fill:#3b2560,stroke:#8a63d2,color:#fff

    class SPA front
    class Nginx,Env,Init infra
    class Backend,Worker code
    class Postgres,Rabbit,Local db
