---
config:
  flowchart:
    diagramPadding: 60
    nodeSpacing: 22
    rankSpacing: 90
    wrappingWidth: 500
---
flowchart LR
    Client(["Веб-приложение"])

    subgraph Pipeline["Middleware"]
        AuthN["Authentication<br/>нет JWT → 401"]
        AuthZ["Authorization<br/>чужая роль → 403"]
        Valid["Валидация модели<br/>→ 400"]
        AuthN --> AuthZ --> Valid
    end

    Client --> AuthN

    subgraph Controllers["Controllers · эндпоинт · метод · роль · коды ответа"]
        subgraph AuthCtl["AuthController"]
            E_reg["POST /api/auth/register · Register<br/>anonymous · 201 400 409"]
            E_login["POST /api/auth/login · Login<br/>anonymous · 200 400 401 403"]
            E_refresh["POST /api/auth/refresh · Refresh<br/>cookie refresh_token · 200 401"]
            E_logout["POST /api/auth/logout · Logout<br/>cookie refresh_token · 204"]
            E_key["GET /api/auth/server-key · GetServerKey<br/>anonymous · 200"]
            E_cert["GET /api/auth/worker-cert · GetWorkerCert<br/>Worker · 200 403"]
        end
        subgraph CompaniesCtl["CompaniesController"]
            E_companies["GET /api/companies/my · GetMyCompany<br/>любая роль · 200 404"]
        end
        subgraph UsersCtl["UsersController · только своя компания"]
            E_me["GET /api/users/me · GetMe<br/>любая роль · 200 404"]
            E_users["GET /api/users · GetUsers<br/>Owner · 200"]
            E_fire["DELETE /api/users/{id} · DeactivateUser<br/>Owner · 200 400 404 409"]
            E_approve["POST /api/users/{id}/approve · ApproveUser<br/>Owner · 200 400 404"]
        end
        subgraph ToolsCtl["ToolsController · только своя компания"]
            E_tools["GET /api/tools · GetTools<br/>Issuer, Owner · 200"]
            E_tnew["POST /api/tools · CreateTool<br/>Issuer, Owner · 201 400"]
            E_tget["GET /api/tools/{id} · GetTool<br/>Issuer, Owner · 200 400 404"]
            E_tpatch["PATCH /api/tools/{id} · UpdateToolCondition<br/>Issuer, Owner · 200 400 404"]
            E_tdel["DELETE /api/tools/{id} · DeleteTool<br/>Owner · 200 400 404"]
        end
        subgraph SyncCtl["SyncController · только своя компания"]
            E_sync["POST /api/sync · Sync<br/>Issuer · 200 400"]
            E_logs["GET /api/logs · GetLogs<br/>Issuer, Owner · 200 400"]
        end
        subgraph NotificationsCtl["NotificationsController · только своя компания"]
            E_notes["GET /api/notifications · GetNotifications<br/>Owner · 200"]
            E_read["POST /api/notifications/{id}/read · MarkNotificationRead<br/>Owner · 200 400 404"]
        end
    end

    Valid --> AuthCtl & CompaniesCtl & UsersCtl & ToolsCtl & SyncCtl & NotificationsCtl

    subgraph Services["Services · метод · что вызывает внутри"]
        subgraph AuthSvc["AuthService"]
            S_reg["RegisterAsync<br/>Normalize · Hash<br/>Owner создаёт компанию, остальные<br/>указывают её id"]
            S_login["LoginAsync<br/>Normalize · Verify · CreateAccessToken<br/>(id, роль, компания) · новая сессия"]
            S_refresh["RefreshAsync<br/>ротация токена · повтор погашенного<br/>гасит всю сессию"]
            S_logout["LogoutAsync<br/>гасит сессию токена"]
            S_key["GetServerKey<br/>ServerPublicKey · время сервера"]
            S_cert["IssueWorkerCertificateAsync<br/>GenerateKeyPair · SignWithServerKey"]
        end
        subgraph CompaniesSvc["CompaniesService"]
            S_companies["GetCompanyAsync<br/>id компании из JWT"]
        end
        subgraph UsersSvc["UsersService"]
            S_me["GetMeAsync<br/>id и компания из JWT"]
            S_users["GetUsersAsync"]
            S_fire["DeactivateAsync<br/>себя нельзя → 409<br/>гасит все сессии"]
            S_approve["ApproveAsync"]
        end
        subgraph ToolsSvc["ToolsService"]
            S_tools["GetActiveToolsAsync"]
            S_tnew["CreateAsync"]
            S_tget["GetByIdAsync"]
            S_tpatch["UpdateConditionAsync"]
            S_tdel["DeactivateAsync"]
        end
        subgraph SyncSvc["SyncService"]
            S_sync["SyncAsync<br/>TryParse → 2 подписи · время · сотрудник · инструмент · повтор<br/>→ флаг → INSERT"]
            S_logs["GetLogsAsync"]
        end
        subgraph NotificationsSvc["NotificationsService"]
            S_notes["GetAsync<br/>последние 100 · имя из users"]
            S_read["MarkReadAsync"]
        end
    end

    E_reg --> S_reg
    E_login --> S_login
    E_refresh --> S_refresh
    E_logout --> S_logout
    E_key --> S_key
    E_cert --> S_cert
    E_companies --> S_companies
    E_me --> S_me
    E_users --> S_users
    E_fire --> S_fire
    E_approve --> S_approve
    E_tools --> S_tools
    E_tnew --> S_tnew
    E_tget --> S_tget
    E_tpatch --> S_tpatch
    E_tdel --> S_tdel
    E_sync --> S_sync
    E_logs --> S_logs
    E_notes --> S_notes
    E_read --> S_read

    subgraph DB["PostgreSQL · Npgsql"]
        companies[("companies<br/>id UUID · name")]
        users[("users<br/>id UUID · company_id · phone UNIQUE<br/>role · is_approved · is_active · deactivated_at")]
        rtokens[("refresh_tokens<br/>SHA-256 токена · family_id (сессия)<br/>expires_at · revoked_at")]
        tools[("tools<br/>id UUID · company_id · condition<br/>comment · condition_updated_at · is_active")]
        logs[("rental_logs · неизменяемый<br/>company_id · worker_id · tool_id · issuer_id<br/>(составные FK: всё из одной компании)<br/>validation_flag · signed_payload")]
        v_cur[("tool_current_holders<br/>последняя VALID по tool_id")]
        v_tools[("tools_with_holders<br/>Tool + текущий держатель")]
        outbox[("outbox_events<br/>событие в транзакции изменения<br/>→ OutboxDispatcher → RabbitMQ")]
        notes[("notifications<br/>пишет AccountThis.Worker")]
    end

    S_reg -->|"INSERT"| users
    S_reg -->|"Owner: INSERT"| companies
    S_companies -->|"SELECT"| companies
    S_login -->|"SELECT по phone"| users
    S_login -->|"INSERT новой сессии"| rtokens
    S_refresh -->|"SELECT FOR UPDATE · UPDATE revoked_at · INSERT"| rtokens
    S_refresh -->|"роль и компания"| users
    S_logout -->|"UPDATE revoked_at сессии"| rtokens
    S_cert -->|"SELECT по id"| users
    S_me -->|"SELECT по id своей компании"| users
    S_users -->|"SELECT своей компании"| users
    S_fire -->|"UPDATE is_active, deactivated_at"| users
    S_fire -->|"UPDATE revoked_at всех сессий"| rtokens
    S_approve -->|"UPDATE is_approved"| users

    S_tools -->|"SELECT активные своей компании"| v_tools
    S_tget -->|"SELECT по id"| v_tools
    S_tnew -->|"INSERT"| tools
    S_tpatch -->|"UPDATE condition, comment"| tools
    S_tdel -->|"UPDATE is_active"| tools

    S_sync -->|"SELECT workerId своей компании"| users
    S_sync -->|"SELECT toolId своей компании, UPDATE condition"| tools
    S_sync -->|"SELECT подпись, INSERT с company_id"| logs
    S_logs -->|"SELECT своей компании"| logs
    S_notes -->|"SELECT своей компании"| notes
    S_read -->|"UPDATE read_at"| notes
    S_reg & S_login & S_refresh & S_fire & S_approve & S_tnew & S_tpatch & S_tdel & S_sync -->|"INSERT события"| outbox

    logs -.-> v_cur -.-> v_tools
    tools -.-> v_tools
    companies -.-> users & tools
    users -.-> rtokens

    classDef actor fill:#1f4d3a,stroke:#3fb27f,color:#fff
    classDef mw fill:#1e3a5f,stroke:#4a8fd6,color:#fff
    classDef code fill:#23232f,stroke:#6b6b80,color:#fff
    classDef db fill:#3b2560,stroke:#8a63d2,color:#fff

    class Client actor
    class AuthN,AuthZ,Valid mw
    class E_reg,E_login,E_refresh,E_logout,E_key,E_cert,E_companies,E_me,E_users,E_fire,E_approve,E_tools,E_tnew,E_tget,E_tpatch,E_tdel,E_sync,E_logs,E_notes,E_read code
    class S_reg,S_login,S_refresh,S_logout,S_key,S_cert,S_companies,S_me,S_users,S_fire,S_approve,S_tools,S_tnew,S_tget,S_tpatch,S_tdel,S_sync,S_logs,S_notes,S_read code
    class companies,users,rtokens,tools,logs,v_cur,v_tools,outbox,notes db
