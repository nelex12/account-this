# PostgreSQL
POSTGRES_USER=accountthis_user
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=accountthis_db

# Порт PostgreSQL
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=accountthis
RABBITMQ_PASSWORD=change_me_please

# Порт API
BACKEND_PORT=5000

# Домен для HTTPS
DOMAIN=stackalg.tech

# Swagger UI
ENABLE_SWAGGER=true

# Ключ Ed25519 для сертификатов. Смена ключа нарушит проверку старых подписей.
SERVER_SIGNING_KEY=
# Ключ подписи JWT
JWT_SIGNING_KEY=
