# Скопируйте этот файл в .env и поменяйте значения на свои.
# .env — единый файл настроек и секретов: его читает docker compose, а backend при запуске из IDE
# (Development) находит его сам в корне репозитория. Строка подключения к БД собирается из POSTGRES_*.
POSTGRES_USER=accountthis_user
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=accountthis_db

# Порт, на котором база будет доступна с вашего компьютера (для DBeaver/pgAdmin и т.д.)
POSTGRES_PORT=5432

# Порт, на котором backend в Docker будет доступен с вашего компьютера напрямую (без nginx).
# При запуске из IDE backend слушает порт 5000 (Properties/launchSettings.json), его же ждёт Vite-прокси
BACKEND_PORT=5000

# Показывать ли Swagger UI. На локальной разработке - true, на проде поставим false
ENABLE_SWAGGER=true

# Ключи сервера. Сгенерируйте запуском generate-keys.bat и вставьте сюда.
# Генерируются один раз на окружение: после смены SERVER_SIGNING_KEY старые сертификаты
# и записи журнала перестают проходить проверку подписи сервера.
# Приватный ключ Ed25519 (32-байтный seed, base64url) - подпись сертификатов сотрудников
SERVER_SIGNING_KEY=
# Секрет HMAC-SHA256 (32 байта, base64url) - подпись JWT
JWT_SIGNING_KEY=

# Первый Owner - создаётся сервером при старте, если в БД нет ни одного Owner.
# Телефон - российский номер (+7..., 8... или 7...), сервер приводит его к виду +7XXXXXXXXXX. ФИО - до 100 символов.
OWNER_PHONE=+70000000000
OWNER_PASSWORD=change_me_please
OWNER_FULLNAME=Владелец
